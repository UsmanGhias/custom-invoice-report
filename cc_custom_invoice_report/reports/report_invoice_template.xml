<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_custom_invoice_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="o.company_id"/>
            <t t-call="cc_custom_invoice_report.custom_invoice_header_layout"/>

            <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 12px; color: #1e1b2e;">
                <!-- Document Title & Meta -->
                <div class="row mt-3 mb-3">
                    <div class="col-6">
                        <div style="background-color: #f9f6fd; border-left: 4px solid #8e45f1; padding: 12px; border-radius: 4px;">
                            <div style="font-size: 11px; text-transform: uppercase; color: #713c69; font-weight: bold;">Billed To:</div>
                            <div style="font-size: 14px; font-weight: bold; color: #1e1b2e;" t-field="o.partner_id.name"/>
                            <div t-if="o.partner_id.street" t-field="o.partner_id.street"/>
                            <div t-if="o.partner_id.city"><span t-field="o.partner_id.city"/>, <span t-if="o.partner_id.country_id" t-field="o.partner_id.country_id.name"/></div>
                            <div t-if="o.partner_id.vat"><span style="font-weight: bold;">VAT / Tax ID: </span><span t-field="o.partner_id.vat"/></div>
                        </div>
                    </div>
                    <div class="col-6 text-end">
                        <h2 style="color: #8e45f1; font-weight: bold; text-transform: uppercase; margin-bottom: 4px;">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Tax Invoice</span>
                            <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                            <span t-elif="o.move_type == 'out_refund'">Credit Note</span>
                            <span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span>
                            <span t-else="">Invoice</span>
                        </h2>
                        <div style="font-size: 15px; font-weight: bold; color: #1e1b2e;" t-field="o.name"/>
                        <div class="mt-2" style="font-size: 11px; color: #5a5266;">
                            <div><span style="font-weight: bold;">Invoice Date: </span><span t-field="o.invoice_date"/></div>
                            <div t-if="o.invoice_date_due"><span style="font-weight: bold;">Due Date: </span><span t-field="o.invoice_date_due"/></div>
                            <div t-if="o.ref"><span style="font-weight: bold;">Reference: </span><span t-field="o.ref"/></div>
                        </div>
                    </div>
                </div>

                <!-- Invoice Lines Table -->
                <table class="table table-sm mt-3" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #8e45f1; color: #ffffff; font-size: 11px; text-transform: uppercase;">
                            <th style="padding: 8px 6px; border: none;">Description</th>
                            <th class="text-end" style="padding: 8px 6px; border: none;">Qty</th>
                            <th class="text-end" style="padding: 8px 6px; border: none;">Unit Price</th>
                            <th class="text-end" style="padding: 8px 6px; border: none;" t-if="display_discount">Disc.%</th>
                            <th class="text-end" style="padding: 8px 6px; border: none;">Taxes</th>
                            <th class="text-end" style="padding: 8px 6px; border: none;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="o.invoice_line_ids.filtered(lambda l: not l.display_type)"/>
                        <tr t-foreach="lines" t-as="line" style="border-bottom: 1px solid #ede7f6;">
                            <td style="padding: 8px 6px;">
                                <div style="font-weight: bold;" t-field="line.product_id.name"/>
                                <div t-if="line.name and line.name != line.product_id.name" style="font-size: 11px; color: #5a5266;" t-field="line.name"/>
                            </td>
                            <td class="text-end" style="padding: 8px 6px;" t-field="line.quantity"/>
                            <td class="text-end" style="padding: 8px 6px;" t-field="line.price_unit"/>
                            <td class="text-end" style="padding: 8px 6px;" t-if="display_discount" t-field="line.discount"/>
                            <td class="text-end" style="padding: 8px 6px;">
                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"/>
                            </td>
                            <td class="text-end" style="padding: 8px 6px; font-weight: bold;" t-field="line.price_subtotal"/>
                        </tr>
                    </tbody>
                </table>

                <!-- Totals & Amount in Words -->
                <div class="row mt-4">
                    <div class="col-7">
                        <div t-if="o.amount_in_words" style="background-color: #f9f6fd; border: 1px solid #ebdcf8; padding: 12px; border-radius: 6px;">
                            <span style="font-size: 11px; font-weight: bold; color: #713c69; text-transform: uppercase;">Amount in Words:</span>
                            <div style="font-size: 13px; font-weight: bold; color: #1e1b2e; margin-top: 4px;" t-field="o.amount_in_words"/>
                        </div>
                        <div t-if="o.narration" class="mt-3" style="font-size: 11px; color: #5a5266;">
                            <span style="font-weight: bold; color: #1e1b2e;">Terms &amp; Notes:</span>
                            <div t-field="o.narration"/>
                        </div>
                    </div>
                    <div class="col-5">
                        <table class="table table-sm" style="width: 100%; border: none;">
                            <tr style="border-top: 1px solid #ede7f6;">
                                <td style="padding: 6px 0; color: #5a5266;">Untaxed Amount:</td>
                                <td class="text-end" style="padding: 6px 0; font-weight: bold;" t-field="o.amount_untaxed"/>
                            </tr>
                            <tr t-if="o.amount_tax" style="border-top: 1px solid #ede7f6;">
                                <td style="padding: 6px 0; color: #5a5266;">Taxes:</td>
                                <td class="text-end" style="padding: 6px 0; font-weight: bold;" t-field="o.amount_tax"/>
                            </tr>
                            <tr style="border-top: 2px solid #8e45f1; background-color: #f9f6fd;">
                                <td style="padding: 8px 6px; font-size: 14px; font-weight: bold; color: #1e1b2e;">Total:</td>
                                <td class="text-end" style="padding: 8px 6px; font-size: 15px; font-weight: bold; color: #8e45f1;" t-field="o.amount_total"/>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_custom_invoice_view">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="cc_custom_invoice_report.report_custom_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>

</odoo>
