<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_invoice_header_layout">
        <div class="header" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
            <div class="row align-items-center mb-2 pb-2" style="border-bottom: 2px solid #8e45f1;">
                <div class="col-6">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 70px;" alt="Company Logo"/>
                    <h3 t-if="not company.logo" t-field="company.name" style="color: #1e1b2e; font-weight: bold;"/>
                </div>
                <div class="col-6 text-end" style="font-size: 11px; color: #5a5266; line-height: 1.4;">
                    <div style="font-size: 13px; font-weight: bold; color: #1e1b2e;" t-field="company.name"/>
                    <div t-if="company.street" t-esc="company.street"/>
                    <div t-if="company.city"><span t-esc="company.city"/>, <span t-if="company.country_id" t-esc="company.country_id.name"/></div>
                    <div t-if="company.vat"><span style="font-weight: bold;">Tax ID / VAT: </span><span t-esc="company.vat"/></div>
                    <div t-if="company.email"><span style="font-weight: bold;">Email: </span><span t-esc="company.email"/></div>
                </div>
            </div>
        </div>

        <div class="footer" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #713c69; border-top: 1px solid #ebdcf8; padding-top: 6px;">
            <div class="row">
                <div class="col-8">
                    <span>Thank you for your business. For billing inquiries, contact </span>
                    <span t-esc="company.email or company.phone"/>
                </div>
                <div class="col-4 text-end">
                    <span>Page </span><span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
    </template>

</odoo>
