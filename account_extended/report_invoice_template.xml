<odoo>
    <template id="report_invoice_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="account_extended.header_layout_invoice"/>
                <div class="page">
                    <div class="text-center" style="font-size: 22px; font-weight: bold;">
                        - Invoice -
                    </div>
                    <div class="mt-2 mb-4">
                        <strong>Invoice No:</strong> <t t-esc="o.name or 'N/A'"/><br/>
                        <strong>Date:</strong> <t t-esc="o.invoice_date or 'N/A'"/><br/>
                        <strong>Customer:</strong> <t t-esc="o.partner_id.name or 'N/A'"/>
                    </div>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Description</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr>
                                    <td><t t-esc="line.sequence or ''"/></td>
                                    <td><t t-esc="line.name or ''"/></td>
                                    <td><t t-esc="line.quantity or 0"/></td>
                                    <td><t t-esc="line.price_unit or 0"/></td>
                                    <td><t t-esc="line.price_total or 0"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
